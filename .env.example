# ---------------------------------------------------------------------------
# Template. Copy to .env and fill in BASE_URL / USERNAME / PASSWORD.
# ---------------------------------------------------------------------------


# --- Environment ---
BASE_URL=https://your-environment.digit.org
TENANTID=mz
LOCALE=en_DEMO

# --- Credentials ---
USERNAME=your-username
PASSWORD=your-password
USERTYPE=EMPLOYEE
# Standard DIGIT OAuth client header (base64 of "egov-user-client:")
CLIENT_AUTH_HEADER=Basic ZWdvdi11c2VyLWNsaWVudDo=

# --- Search defaults ---
SEARCH_LIMIT=100
SEARCH_OFFSET=0

# --- Boundary ---
BOUNDARY_HIERARCHY_CODE=MICROPLAN
# Top level of the hierarchy, e.g. PAYS or COUNTRY — must match the environment
BOUNDARY_TYPE=PAYS
# A boundary code that exists in this environment; used as the locality on
# households/individuals, so a leaf boundary is the safe choice
BOUNDARY_CODE=

# --- Service base paths used by the service-level suites ---
SERVICE_INDIVIDUAL=individual
SERVICE_PROJECT=project
SERVICE_MDMS=mdms-v2
SERVICE_HRMS=egov-hrms
SERVICE_PGR=pgr-services

# --- Negative testing ---
INVALID_TENANT_ID=invalid_tenant

# ---------------------------------------------------------------------------
# Console (campaign) suite — tests/console
# ---------------------------------------------------------------------------

# Service base paths
SERVICE_PROJECT_FACTORY=/project-factory/v1/project-type
SERVICE_EXCEL_INGESTION=/excel-ingestion/v1/data
SERVICE_FILESTORE=/filestore/v1/files
SERVICE_PROJECT_BASE=/project/v1
SERVICE_PROJECT_FACILITY=/project/facility/v1
SERVICE_PROJECT_STAFF=/project/staff/v1
SERVICE_BOUNDARY=/boundary-service
SERVICE_LOCALIZATION=/localization

# Campaign context. Defaults to the BOUNDARY_* values above when unset.
CONSOLE_HIERARCHY_TYPE=MICROPLAN
CONSOLE_ROOT_BOUNDARY_CODE=

# Campaign types to run. Comma-separated keys from
# data/console/campaign_types.json. Leave empty to run all of them.
CONSOLE_CAMPAIGN_TYPES=BEDNET,MR-DN

# Excel ingestion resource types (project-factory <-> excel-ingestion contract)
CONSOLE_GENERATE_TYPE=unified-console
CONSOLE_VALIDATION_TYPE=unified-console-validation
CONSOLE_RESOURCE_TYPE=unified-console-resources
CONSOLE_FILESTORE_MODULE=HCM-ADMIN-CONSOLE

# filestoreId of a template already filled with valid campaign data. The
# generated template is empty, so the end-to-end upload/validate/create tests
# need a populated one. Leave blank to skip those tests.
#
# Only used when no sample template exists for the campaign type. A single id
# cannot serve two types (their Boundary List target columns differ), so
# prefer the per-type keys; the global one is a single-type fallback.
CONSOLE_PREFILLED_FILESTORE_ID=
CONSOLE_PREFILLED_FILESTORE_ID_MR_DN=
CONSOLE_PREFILLED_FILESTORE_ID_BEDNET=

# Sample filled-in template. Leave blank to use
# data/console/templates/<CAMPAIGN_TYPE>_sample.xlsx.
CONSOLE_SAMPLE_TEMPLATE=

# App configuration masters
APP_CONFIG_SCHEMA_CODE=HCM.APP_CONFIG
APP_CONFIG_LOCALIZATION_MODULE=hcm-appconfig

# Async polling for campaign creation / excel ingestion
CONSOLE_POLL_ATTEMPTS=60
CONSOLE_POLL_DELAY=5

# Campaign name rule mirrored from the console UI
CAMPAIGN_NAME_MAX_LENGTH=30

# Delay applied after a 202 response before reading the entity back
ASYNC_PERSISTER_DELAY=6.0

# ---------------------------------------------------------------------------
# Login flow suite — tests/test_login_flow.py
# ---------------------------------------------------------------------------

# Service paths exercised by the login sequence
SERVICE_OAUTH_TOKEN=/user/oauth/token
SERVICE_USER_SEARCH=/user/_search
SERVICE_ACCESS_ACTIONS=/access/v1/actions/mdms/_get
SERVICE_MDMS_V2_SEARCH=/mdms-v2/v1/_search

# i18n bundles the workbench shell loads before the login form renders
LOGIN_LOCALIZATION_MODULES=rainmaker-common,digit-ui,digit-tenants,rainmaker-demo
# Of those, the ones that must return content (the rest are reported, not failed on)
LOGIN_REQUIRED_LOCALIZATION_MODULES=rainmaker-common,digit-ui
PRIVACY_POLICY_MODULE=digit-privacy-policy

# Access-control master behind the role-based home cards
ACCESS_ACTION_MASTER=actions-test

# Roles the login account must hold. Blank disables the check.
EXPECTED_LOGIN_ROLES=
